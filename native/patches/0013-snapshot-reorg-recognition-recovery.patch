+    bool Wallet::CanProcessTransaction(const BaseTransaction& tx) const
+    {
+        if (!m_RecoveryPolicy) return true;
+        auto it = m_ActiveTransactions.find(tx.GetTxID());
+        return m_RecoveryAdmission && tx.InstanceEpoch() == m_TransactionEpoch &&
+            it != m_ActiveTransactions.end() && it->second.get() == &tx;
+    }
+
+    bool Wallet::AllowRequest(const Request& request) const
+    {
+        if (!m_RecoveryPolicy || m_RecoveryAdmission) return true;
+        if (request.m_RecoveryProof && request.get_Type() == Request::Type::Kernel)
+            return m_RecoveryQuorumConfigured && m_RecoveryLiveTip && !m_RecoveryFailure;
+        switch (request.get_Type())
+        {
+        case Request::Type::Body:
+        case Request::Type::BodyPack:
+        case Request::Type::EnumHdrs:
+        case Request::Type::ShieldedOutputsAt:
+        case Request::Type::StateSummary:
+            return m_RecoveryQuorumConfigured && !m_RecoveryFailure;
+        default:
+            return false;
+        }
+    }
+
+    void Wallet::ConfigureRecoveryQuorum()
+    {
+        auto network = std::dynamic_pointer_cast<proto::FlyClient::NetworkStd>(m_NodeEndpoint);
+        if (!network) throw std::runtime_error("Recovery requires quorum network");
+        network->SetRecoveryQuorum(true);
+        std::weak_ptr<uint8_t> lifetime = m_RecoveryLifetime;
+        network->m_RequestAdmission = [this, lifetime](const Request& r) {
+            return !lifetime.expired() && r.m_WalletEpoch == m_TransactionEpoch && AllowRequest(r);
+        };
+        network->m_RequestEpoch = [this, lifetime] {
+            return lifetime.expired() ? UINT64_MAX : m_TransactionEpoch;
+        };
+        m_RecoveryQuorumConfigured = true;
+    }
+
+    void Wallet::RecordSnapshotImport(const Block::SystemState::Full& tip)
+    {
+        m_RecognitionRecovery.m_Snapshot = true;
+        m_RecognitionRecovery.m_HistoryComplete = false;
+        tip.get_ID(m_RecognitionRecovery.m_Import);
+        storage::setBlobVar(*m_WalletDB, RecognitionRecovery::Key, m_RecognitionRecovery);
+    }
+
+    void Wallet::CloseRecoveryAdmission()
+    {
+        if (!m_RecoveryPolicy) return;
+        m_RecoveryAdmission = false;
+        m_RecoveryLiveTip = false;
+        m_RecoveryProofsStarted = false;
+        m_RecoveryProofHeights.clear();
+        m_RecoveryLiveQuorum = {};
+        m_RecoveryLiveQuorumPending = false;
+        m_WaitingRecoveryCursor = false;
+        m_VerifiedRecoveryCursor = {};
+        m_HistoricalHeaderCandidate = boost::none;
+        m_HistoricalHeaderCandidatePeer = io::Address();
+        m_HistoricalHeaderQuorumRetries = 0;
+        std::dynamic_pointer_cast<WalletDB>(m_WalletDB)->SetSelectionAllowed(false);
+        ++m_TransactionEpoch;
+        for (auto& entry : m_ActiveTransactions) entry.second->Retire();
+        // Drop transaction-bearing requests before payload validation or callback invocation.
+#define DROP_RECOVERY_REQUEST(type) while (!m_Pending##type.empty()) DeleteReq(*m_Pending##type.begin());
+        WalletFlyClientRequests_All(DROP_RECOVERY_REQUEST)
+#undef DROP_RECOVERY_REQUEST
+        ResetBodyQuorumState();
+        m_ShieldedBoundaryCandidate = boost::none;
+        m_ShieldedBoundaryCandidatePeer = io::Address();
+        m_ShieldedBoundaryQuorumRetries = 0;
+    }
+
+    void Wallet::ResetRecognitionRecovery(bool ownBatch)
+    {
+        auto db = std::dynamic_pointer_cast<WalletDB>(m_WalletDB);
+        try
+        {
+            if (ownBatch) db->BeginRecoveryBatch();
+            // This is an index reset, never Rescan/resetCoins/clearTxParameters.
+            db->deleteEventsFrom(0);
+            m_BodyBirthdayBoundary = 0;
+            storage::setVar(*db, kBodyBirthdayBoundary, Height(0));
+            m_Extra.m_ShieldedOutputs = 0;
+            db->set_ShieldedOuts(0);
+            m_ShieldedCountCheckpoints.clear();
+            PersistShieldedCountCheckpoints();
+            storage::setNextEventHeight(*db, 0);
+            SetTreasuryHandled(false);
+            storage::setNeedToRequestBodies(*db, true);
+            m_RecognitionRecovery.m_Boundary = 0;
+            m_RecognitionRecovery.m_Cursor = {};
+            m_RecognitionRecovery.m_Phase = RecognitionRecovery::Replay;
+            storage::setBlobVar(*db, RecognitionRecovery::Key, m_RecognitionRecovery);
+            RecoveryCheckpoint("reset-before-commit");
+            if (ownBatch) db->EndRecoveryBatch(true);
+            ResetCommitmentsCache();
+        }
+        catch (...)
+        {
+            if (ownBatch) db->EndRecoveryBatch(false);
+            m_RecoveryFailure = true; // reopen the engine from the committed Reset marker
+            throw;
+        }
+    }
+
+    bool Wallet::EnsureRecoveryCursor(Height h, std::function<void()>&& resume)
+    {
+        if (!m_RecoveryPolicy || !h || m_VerifiedRecoveryCursor.m_Height == h) return true;
+        Block::SystemState::Full state;
+        if (m_WalletDB->get_History().get_At(state, h))
+        {
+            state.get_ID(m_VerifiedRecoveryCursor);
+            return true;
+        }
+        // The bounded local header cache may no longer contain a historical pack boundary.
+        // Authenticate that header through the existing two-peer historical-header path before
+        // committing the body, rather than labeling the target hash as the cursor block hash.
+        MyRequestEnumHdrs::Ptr request(new MyRequestEnumHdrs);
+        request->m_Msg.m_Height = h;
+        const auto generation = m_BodyRequestGeneration;
+        request->m_RecoveryCallback = [this, generation, resume = std::move(resume)](const Block::SystemState::Full& header) {
+            if (generation != m_BodyRequestGeneration || m_RecoveryFailure) return;
+            header.get_ID(m_VerifiedRecoveryCursor);
+            m_WaitingRecoveryCursor = false;
+            resume();
+        };
+        m_WaitingRecoveryCursor = true;
+        if (!PostReqUnique(*request)) ReportBodyQuorumFailure("Recovery cursor header request unavailable");
+        return false;
+    }
+
+    void Wallet::PersistRecognitionRecovery(Height h)
+    {
+        if (!m_RecoveryPolicy) return;
+        Block::SystemState::Full tip;
+        get_tip(tip);
+        tip.get_ID(m_RecognitionRecovery.m_Target);
+        m_RecognitionRecovery.m_Cursor = h ? m_VerifiedRecoveryCursor : HeightHash{};
+        storage::setBlobVar(*m_WalletDB, RecognitionRecovery::Key, m_RecognitionRecovery);
+    }
+
+    void Wallet::RebuildRecoveryTransactions()
+    {
+        for (auto& entry : m_ActiveTransactions) entry.second->Retire();
+        m_ActiveTransactions.clear(); // no terminal observer, resource release or journal mutation
+        m_NextTipTransactionToUpdate.clear();
+        for (const auto& tx : m_WalletDB->getTxHistory(TxType::ALL)) ResumeTransaction(tx);
+    }
+
+    bool Wallet::FinishRecognitionRecovery()
+    {
+        if (m_RecoveryAdmission) return true;
+        if (!m_RecoveryQuorumConfigured || !m_RecoveryLiveTip || m_RecoveryFailure ||
+            !m_IsTreasuryHandled || SyncRemains()) return false;
+        Block::SystemState::Full tip;
+        get_tip(tip);
+        if (!tip.get_Height() || !IsValidTimeStamp(tip.m_TimeStamp) ||
+            GetEventsHeightNext() <= tip.get_Height()) return false;
+        HeightHash live;
+        tip.get_ID(live);
+        if (m_RecoveryLiveQuorum != live)
+        {
+            if (!m_RecoveryLiveQuorumPending)
+            {
+                // Reopen/completion with no remaining bodies still requires two live peers.
+                // Configuration and a recent cached timestamp alone are not quorum evidence.
+                MyRequestEnumHdrs::Ptr request(new MyRequestEnumHdrs);
+                request->m_Msg.m_Height = live.m_Height;
+                request->m_RecoveryCallback = [this, live](const Block::SystemState::Full& header) {
+                    m_RecoveryLiveQuorumPending = false;
+                    HeightHash agreed;
+                    header.get_ID(agreed);
+                    if (agreed != live) { ReportBodyQuorumFailure("Recovery live header mismatch"); return; }
+                    m_RecoveryLiveQuorum = agreed;
+                    CheckSyncDone();
+                };
+                m_RecoveryLiveQuorumPending = true;
+                if (!PostReqUnique(*request)) ReportBodyQuorumFailure("Recovery live quorum unavailable");
+            }
+            return false;
+        }
+        if (!m_RecoveryProofsStarted)
+        {
+            m_RecoveryProofsStarted = true;
+            // Revalidate persisted kernels before opening selection or reconstructing builders.
+            // A partial/prepared transaction without a kernel continues under its same TxID later.
+            for (const auto& tx : m_WalletDB->getTxHistory(TxType::ALL))
+            {
+                Merkle::Hash kernel;
+                if (!tx.canResume() || !tx.GetParameter(TxParameterID::KernelID, kernel)) continue;
+                MyRequestKernel::Ptr request(new MyRequestKernel);
+                request->m_TxID = tx.m_txId;
+                request->m_Msg.m_ID = kernel;
+                request->m_RecoveryProof = true;
+                PostReqUnique(*request);
+            }
+            if (SyncRemains()) return false;
+        }
+        auto db = std::dynamic_pointer_cast<WalletDB>(m_WalletDB);
+        const auto before = m_RecognitionRecovery;
+        try
+        {
+            for (const auto& proof : m_RecoveryProofHeights)
+            {
+                if (proof.second)
+                    storage::setTxParameter(*db, proof.first, TxParameterID::KernelProofHeight, proof.second, false);
+                else
+                    storage::setTxParameter(*db, proof.first, TxParameterID::KernelUnconfirmedHeight, tip.get_Height(), false);
+            }
+            if (m_RecognitionRecovery.m_Phase == RecognitionRecovery::Replay)
+            {
+                HeightHash id;
+                tip.get_ID(id);
+                if (id.m_Hash != m_RecognitionRecovery.m_Target.m_Hash ||
+                    m_RecognitionRecovery.m_Cursor.m_Height != id.m_Height) return false;
+                m_RecognitionRecovery.m_HistoryComplete = true;
+            }
+            m_RecognitionRecovery.m_Phase = RecognitionRecovery::Complete;
+            m_RecognitionRecovery.m_Generation = m_TransactionEpoch;
+            storage::setBlobVar(*db, RecognitionRecovery::Key, m_RecognitionRecovery);
+            RecoveryCheckpoint("complete-before-commit");
+            db->FlushNow();
+        }
+        catch (...)
+        {
+            db->RollbackNow(false);
+            m_RecognitionRecovery = before;
+            m_RecoveryFailure = true;
+            return false;
+        }
+        try { RecoveryCheckpoint("complete-after-commit"); }
+        catch (...) { m_RecoveryFailure = true; return false; }
+        m_RecoveryAdmission = true;
+        db->SetSelectionAllowed(true);
+        RebuildRecoveryTransactions();
+        return true;
+    }
+
+    void Wallet::ProcessRecoveryEvent(Height h, const proto::Event::Base& evt)
+    {
+        if (evt.get_Type() == proto::Event::Type::Utxo)
+        {
+            const auto& e = Cast::Up<const proto::Event::Utxo&>(evt);
+            auto cid = e.m_Cid;
+            if (!m_WalletDB->IsRecoveredMatch(cid, e.m_Commitment)) return;
+            Coin coin;
+            coin.m_ID = cid;
+            const bool exists = m_WalletDB->findCoin(coin);
+            const auto before = coin;
+            const bool add = (e.m_Flags & proto::Event::Flags::Add) != 0;
+            if (!exists && !add) throw std::runtime_error("Missing recovery input identity");
+            CacheCommitment(e.m_Commitment, e.m_Maturity, add);
+            if (add)
+            {
+                coin.m_confirmHeight = std::min(coin.m_confirmHeight, h);
+                coin.m_maturity = e.m_Maturity;
+            }
+            else coin.m_spentHeight = std::min(coin.m_spentHeight, h);
+            if (!exists || coin.m_confirmHeight != before.m_confirmHeight ||
+                coin.m_maturity != before.m_maturity || coin.m_spentHeight != before.m_spentHeight)
+                m_WalletDB->saveCoin(coin);
+        }
+        else if (evt.get_Type() == proto::Event::Type::Shielded)
+        {
+            const auto& e = Cast::Up<const proto::Event::Shielded&>(evt);
+            auto found = m_WalletDB->getShieldedCoin(e.m_CoinID.m_Key);
+            ShieldedCoin coin = found ? *found : ShieldedCoin{};
+            const auto before = coin;
+            if (!found) coin.m_CoinID = e.m_CoinID;
+            coin.m_TxoID = e.m_TxoID;
+            if (e.m_Flags & proto::Event::Flags::Add)
+                coin.m_confirmHeight = std::min(coin.m_confirmHeight, h);
+            else coin.m_spentHeight = std::min(coin.m_spentHeight, h);
+            if (!found || coin.m_TxoID != before.m_TxoID || coin.m_confirmHeight != before.m_confirmHeight ||
+                coin.m_spentHeight != before.m_spentHeight) m_WalletDB->saveShieldedCoin(coin);
+            // Deliberately no RestoreTransactionFromShieldedCoin: even partial TxIDs are immutable here.
+        }
+    }
