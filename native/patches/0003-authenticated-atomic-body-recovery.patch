+    ECC::Hash::Value Wallet::BodyDigest(const proto::Body& body) const
+    {
+        ECC::Hash::Value digest;
+        ECC::Hash::Processor()
+            << Blob(body.m_Body.m_Perishable)
+            << Blob(body.m_Body.m_Eternal)
+            >> digest;
+        return digest;
+    }
+
+    ECC::Hash::Value Wallet::BodyPackDigest(const proto::BodyPack& bodyPack) const
+    {
+        ECC::Hash::Processor processor;
+        processor << static_cast<uint64_t>(bodyPack.m_Bodies.size());
+        for (const auto& body : bodyPack.m_Bodies)
+            processor << Blob(body.m_Perishable) << Blob(body.m_Eternal);
+        ECC::Hash::Value digest;
+        processor >> digest;
+        return digest;
+    }
