+    bool Wallet::CheckBodyQuorum(MyRequestBody& request)
+    {
+        auto digest = BodyDigest(request.m_Res);
+        if (!m_BodyCandidate)
+        {
+            m_BodyCandidate = digest;
+        }
+        else if (*m_BodyCandidate == digest)
+        {
+            m_BodyCandidate = boost::none;
+            m_BodyQuorumRetries = 0;
+            return true;
+        }
+        else
+        {
+            m_BodyCandidate = boost::none;
+            if (++m_BodyQuorumRetries > 2)
+            {
+                ReportBodyQuorumFailure("Beam body quorum mismatch");
+                return false;
+            }
+        }
+
+        MyRequestBody::Ptr repeated(new MyRequestBody);
+        repeated->m_Msg = request.m_Msg;
+        repeated->m_Height = request.m_Height;
+        PostReqUnique(*repeated);
+        return false;
+    }
+
