+        {
+            m_BodyPackCandidate = boost::none;
+            if (++m_BodyPackQuorumRetries > 2)
+            {
+                ReportBodyQuorumFailure("Beam node returned an empty recovery body pack");
+                return false;
+            }
+        }
+        else
+        {
+            auto digest = BodyPackDigest(request.m_Res);
+            if (!m_BodyPackCandidate)
+            {
+                m_BodyPackCandidate = digest;
+            }
+            else if (*m_BodyPackCandidate == digest)
+            {
+                m_BodyPackCandidate = boost::none;
+                m_BodyPackQuorumRetries = 0;
+                return true;
+            }
+            else
+            {
+                m_BodyPackCandidate = boost::none;
+                if (++m_BodyPackQuorumRetries > 2)
+                {
+                    ReportBodyQuorumFailure("Beam body-pack quorum mismatch");
+                    return false;
+                }
+            }
+        }
+
+        MyRequestBodyPack::Ptr repeated(new MyRequestBodyPack);
+        repeated->m_Msg = request.m_Msg;
+        repeated->m_StartHeight = request.m_StartHeight;
+        PostReqUnique(*repeated);
+        return false;
+    }
