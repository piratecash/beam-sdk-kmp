+void FlyClient::NetworkStd::ClearRecoveryResponse(Request& request)
+{
+    request.m_RecoveryResponder = io::Address();
+    switch (request.get_Type())
+    {
+    case Request::Type::EnumHdrs:
+        request.As<RequestEnumHdrs>().m_vStates.clear();
+        break;
+    case Request::Type::ShieldedOutputsAt:
+        request.As<RequestShieldedOutputsAt>().m_Res = proto::ShieldedOutputsAt();
+        break;
+    case Request::Type::BodyPack:
+        request.As<RequestBodyPack>().m_Res = proto::BodyPack();
+        break;
+    case Request::Type::Body:
+        request.As<RequestBody>().m_Res = proto::Body();
+        break;
+    default:
+        break;
+    }
+}
