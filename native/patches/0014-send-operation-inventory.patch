+    std::vector<std::pair<std::string, ByteBuffer>> WalletDB::getBlobsByPrefix(const std::string& prefix) const
+    {
+        sqlite::Statement stm(this, "SELECT name, value FROM " VARIABLES_NAME
+            " WHERE substr(name, 1, length(?1)) = ?1 COLLATE BINARY ORDER BY name COLLATE BINARY;");
+        stm.bind(1, prefix);
+        std::vector<std::pair<std::string, ByteBuffer>> result;
+        while (stm.step())
+        {
+            ByteBuffer name, value;
+            stm.get(0, name);
+            stm.get(1, value);
+            result.emplace_back(std::string(name.begin(), name.end()), std::move(value));
+        }
+        return result;
+    }
