+        GetTimeNnz_ms() - m_RecoveryParkSince >= s_RecoveryParkReportThreshold_ms)
+    {
+        m_RecoveryParkReported = true;
+        // Unset whenever the transport was armed without a wallet behind it, e.g. a direct
+        // SetRecoveryQuorum in a transport-level test. Parking then stays silent, as before.
+        if (m_RecoveryParkReport)
+            m_RecoveryParkReport("Beam recovery stalled: fewer than two nodes qualify for the quorum");
+    }
+}
+
+void FlyClient::NetworkStd::OnRecoveryAssigned()
+{
+    m_RecoveryParkSince = 0;
+    m_RecoveryParkReported = false;
