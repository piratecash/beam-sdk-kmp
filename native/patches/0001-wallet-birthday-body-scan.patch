index fb7dc0a..4af56a6 100644
--- a/wallet/core/wallet.cpp
+++ b/wallet/core/wallet.cpp
@@ -1522,13 +1522,31 @@ namespace beam::wallet
 
     void Wallet::OnRequestComplete(MyRequestStateSummary& r)
     {
-        // TODO: save full response?
-        m_WalletDB->set_ShieldedOuts(r.m_Res.m_ShieldedOuts);
-        m_WalletDB->set_AidMax(r.m_Res.m_AssetsMax);
+        // StateSummary is not authenticated by the verified header chain. In mobile body
+        // mode the cumulative value belongs to the locally processed body cursor and must
+        // never be replaced by a node's tip-wide counter.
         if (!IsMobileNodeEnabled())
         {
+            m_WalletDB->set_ShieldedOuts(r.m_Res.m_ShieldedOuts);
             m_Extra.m_ShieldedOutputs = r.m_Res.m_ShieldedOuts;
         }
+        m_WalletDB->set_AidMax(r.m_Res.m_AssetsMax);
+    }
+
+    void Wallet::StartBodyRequestsAt(Height heightInclusive, TxoID shieldedOutputsBefore)
+    {
+        assertThread();
+        AbortEvents();
+        AbortBodiesRequests();
+
+        m_Extra.m_ShieldedOutputs = shieldedOutputsBefore;
+        m_WalletDB->set_ShieldedOuts(shieldedOutputsBefore);
+        storage::setNextEventHeight(*m_WalletDB, heightInclusive);
+        SetTreasuryHandled(heightInclusive != 0);
+        storage::setNeedToRequestBodies(*m_WalletDB, true);
+
+        ResetCommitmentsCache();
+        RequestBodies();
     }
 
     void Wallet::OnRequestComplete(MyRequestShieldedOutputsAt& r)
