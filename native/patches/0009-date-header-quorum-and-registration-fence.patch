+    bool Wallet::CheckHistoricalHeaderQuorum(MyRequestEnumHdrs& request)
+    {
+        HeightHash id;
+        const bool valid = request.m_vStates.size() == 1 &&
+            request.m_vStates.front().get_Height() == request.m_Msg.m_Height.m_Min;
+        if (valid)
+            request.m_vStates.front().get_ID(id);
+
+        if (!valid)
+        {
+            m_HistoricalHeaderCandidate = boost::none;
+            m_HistoricalHeaderCandidatePeer = io::Address();
+            if (++m_HistoricalHeaderQuorumRetries > 2)
+            {
+                ReportBodyQuorumFailure("Beam nodes could not provide the requested historical header");
+                return false;
+            }
+        }
+        else if (!m_HistoricalHeaderCandidate)
+        {
+            m_HistoricalHeaderCandidate = id;
+            m_HistoricalHeaderCandidateTimestamp = request.m_vStates.front().m_TimeStamp;
+            m_HistoricalHeaderCandidatePeer = request.m_RecoveryResponder;
+        }
+        else if (m_HistoricalHeaderCandidatePeer != request.m_RecoveryResponder &&
+            *m_HistoricalHeaderCandidate == id &&
+            m_HistoricalHeaderCandidateTimestamp == request.m_vStates.front().m_TimeStamp)
+        {
+            m_HistoricalHeaderCandidate = boost::none;
+            m_HistoricalHeaderCandidatePeer = io::Address();
+            m_HistoricalHeaderQuorumRetries = 0;
+            return true;
+        }
+        else if (m_HistoricalHeaderCandidatePeer != request.m_RecoveryResponder)
+        {
+            m_HistoricalHeaderCandidate = boost::none;
+            m_HistoricalHeaderCandidatePeer = io::Address();
+            if (++m_HistoricalHeaderQuorumRetries > 2)
+            {
+                ReportBodyQuorumFailure("Beam historical-header quorum mismatch");
+                return false;
+            }
+        }
+
+        MyRequestEnumHdrs::Ptr repeated(new MyRequestEnumHdrs);
+        repeated->m_Msg = request.m_Msg;
+        repeated->m_callback = request.m_callback;
+        repeated->m_RecoveryExcludedAddress = request.m_RecoveryResponder;
+        PostReqUnique(*repeated);
+        return false;
+    }
