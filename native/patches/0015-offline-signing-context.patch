+    bool BaseTxBuilder::SelectShieldedWindow(const ShieldedCoin& c, TxoID nShieldedCurrently, ShieldedWindow& out)
+    {
+        if (c.m_TxoID >= nShieldedCurrently) return false;
+        ShieldedCoin::UnlinkStatus us(c, nShieldedCurrently);
+
+        bool bWndLost = us.IsLargeSpendWindowLost();
+        out.m_Cfg = bWndLost ?
+            Rules::get().Shielded.m_ProofMin :
+            Rules::get().Shielded.m_ProofMax;
+
+        out.m_N = out.m_Cfg.get_N();
+        if (!out.m_N)
+            return false;
+
+        out.m_Index = c.get_WndIndex(out.m_N);
+
+        if (!bWndLost && (us.m_WndReserve0 < 0))
+        {
+            // move the selected window forward
+            out.m_Index += us.m_WndReserve0; // actually decrease
+            assert(out.m_Index < out.m_N);
+        }
+
+        out.m_Start = c.m_TxoID - out.m_Index;
+        out.m_Count = out.m_N;
+
+        TxoID nWndEnd = out.m_Start + out.m_N;
+        if (nWndEnd > nShieldedCurrently)
+        {
+            // move the selected window backward
+            uint32_t nExtra = static_cast<uint32_t>(nWndEnd - nShieldedCurrently);
+            if (nExtra < out.m_Start)
+                out.m_Start -= nExtra;
+            else
+            {
+                nExtra = static_cast<uint32_t>(out.m_Start);
+                out.m_Start = 0;
+            }
+
+            out.m_Index += nExtra;
+            out.m_Count += nExtra;
+        }
+
+        return true;
+    }
