+            m_OfflineTransaction || !db || !db->IsSelectionAllowed() || !parameters.GetTxID() ||
+            !IsOfflineSigningIntent(*parameters.GetTxID()) || !admission || !admission())
+            throw std::runtime_error("Offline capability admission failed");
+        const auto id = *parameters.GetTxID();
+        // The SDK has validated the complete inventory and flushed its intent already.
+        // A retry resumes the original row, never repeats voucher preparation or rewrites keys.
+        if (!db->getTx(id))
+        {
+            auto completed = creator->CheckAndCompleteParameters(parameters);
+            auto tx = creator->Create(BaseTransaction::TxContext(*this, gateway, id));
+            ApplyTransactionParameters(tx, completed.Pack(), true);
+            db->FlushNow();
+            m_OfflineTransaction = std::move(tx);
+        }
+        else m_OfflineTransaction = creator->Create(BaseTransaction::TxContext(*this, gateway, id));
+        m_OfflineAdmission = std::move(admission);
+        return m_OfflineTransaction;
+    }
+
+    void Wallet::EndOfflineTransaction()
+    {
+        if (m_OfflineTransaction) m_OfflineTransaction->Retire();
+        m_OfflineAdmission = {};
+        m_OfflineTransaction.reset();
+    }
