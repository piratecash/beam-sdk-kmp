+    bool Wallet::CollectOfflineTransactions(std::set<std::string>& hexIds) const
+    {
+        auto db = std::dynamic_pointer_cast<WalletDB>(m_WalletDB);
+        if (!db) return false;
+        try
+        {
+            for (const auto& entry : db->getBlobsByPrefix("beam.sdk.kmp.send.v"))
+            {
+                const auto j = nlohmann::json::parse(entry.second.begin(), entry.second.end());
+                if (entry.first.find("beam.sdk.kmp.send.v1.") != 0 ||
+                    j.find("txId") == j.end() || !j.at("txId").is_string()) return false;
+                if (j.find("version") == j.end())
+                {
+                    if (j.find("mode") != j.end()) return false;
+                    const auto state = j.at("state").get<std::string>();
+                    if (state != "Prepared" && state != "Committing" && state != "Submitted") return false;
+                    continue; // unchanged legacy online record
+                }
+                if (j.at("version") != 2 || j.at("mode") != "Offline") return false;
+                const auto state = j.at("state").get<std::string>();
+                if (state != "Signing" && state != "Signed" && state != "Exported") return false;
+                hexIds.insert(j.at("txId").get<std::string>());
+            }
+            return true;
+        }
+        catch (...) { return false; } // no parser diagnostics / receiver material
+    }
+
+    bool Wallet::IsOfflineTransaction(const TxID& id) const
+    {
+        std::set<std::string> offline;
+        return !CollectOfflineTransactions(offline) || offline.count(to_hex(id.data(), id.size()));
+    }
+
+    bool Wallet::IsOfflineSigningIntent(const TxID& id) const
+    {
+        auto db = std::dynamic_pointer_cast<WalletDB>(m_WalletDB);
+        if (!db) return false;
+        try
+        {
+            const auto hex = to_hex(id.data(), id.size());
+            for (const auto& entry : db->getBlobsByPrefix("beam.sdk.kmp.send.v"))
+            {
+                const auto j = nlohmann::json::parse(entry.second.begin(), entry.second.end());
+                if (j.at("txId") == hex)
+                    return j.at("version") == 2 && j.at("mode") == "Offline" && j.at("state") == "Signing";
+            }
+        }
+        catch (...) {}
+        return false;
+    }
+
+    void Wallet::RequestOfflineKernelProofs()
+    {
+        // One round per wallet instance, i.e. per SDK start; rows already observed are not asked again.
+        if (m_OfflineKernelProofsRequested || m_ExecutionMode == ExecutionMode::Offline || !IsRecoveryAdmissionOpen()) return;
+        m_OfflineKernelProofsRequested = true;
+        std::set<std::string> offline;
+        const bool known = CollectOfflineTransactions(offline); // unreadable inventory: treat every row as offline
+        for (const auto& tx : m_WalletDB->getTxHistory(TxType::ALL))
+        {
+            Merkle::Hash kernel;
+            Height observed = 0;
+            tx.GetParameter(TxParameterID::KernelProofHeight, observed);
+            if ((known && !offline.count(to_hex(tx.m_txId.data(), tx.m_txId.size()))) || observed ||
+                !tx.GetParameter(TxParameterID::KernelID, kernel)) continue;
+            MyRequestKernel::Ptr request(new MyRequestKernel);
+            request->m_TxID = tx.m_txId;
+            request->m_Msg.m_ID = kernel;
+            PostReqUnique(*request); // chain observation only, never a transaction creator
+        }
+    }
+
