--- a/wallet/core/wallet_db.h
+++ b/wallet/core/wallet_db.h
@@ -834,7 +834,21 @@ namespace beam::wallet
         // the pending SQL transaction durable synchronously. The standard UI
         // relies on its running flush timer and cannot provide this guarantee.
