-        void RollbackNow() { rollbackDB(); }
+        void RollbackNow(bool notifyObservers = true) {
+            rollbackDB();
+            // A rolled-back body may already have populated the parameter cache and emitted
+            // observer notifications. Invalidate the cache and publish authoritative resets so
+            // replay cannot mistake rolled-back parameters for durable rows.
+            m_TxParametersCache.clear();
+            if (notifyObservers) {
+                notifyTransactionChanged(
+                    ChangeAction::Reset,
+                    getTxHistory(wallet::TxType::ALL, 0, std::numeric_limits<int>::max())
+                );
+                notifyCoinsChanged(ChangeAction::Reset, getAllNormalCoins());
+                notifyShieldedCoinsChanged(ChangeAction::Reset, getAllShieldedCoins());
+            }
+        }
 
